# Build outputs and delivery artefacts (regenerated by work\make_release.bat).
# Only the entry scripts needed for a fresh clone are tracked; build dirs,
# logs and scratch folders inside work/ stay ignored.
/work/*
!/work/build_app.bat
!/work/build_tests22.bat
!/work/fix_showincludes_prefix.ps1
!/work/make_release.bat
!/work/run_selftest.ps1
!/work/run_tests22.ps1
!/work/testproj/
/work/testproj/*
!/work/testproj/CMakeLists.txt
/outputs/
/build/

# Vendored third-party: JUCE 8.0.15 lives in NiDaw\external\JUCE and is tracked
# so a fresh clone builds offline (see NiDaw\docs\05-build-env.md).

# Editors / OS
.vs/
*.user
*.suo
Thumbs.db
desktop.ini

# Build artefacts / logs
*.pdb
*.lib
*.exe
*.zip
*.log
/work/signing/

# Internal AI/agent handoff notes, not part of the public project.
/DEEPSEEK_HARNESS_HANDOFF_*.md
