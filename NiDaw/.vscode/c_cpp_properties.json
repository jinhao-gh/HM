{
    // 只影响 VS Code 的 IntelliSense（红波浪线），不参与编译。
    // 真正的 include 路径与宏以 CMake 生成的 compile_commands.json 为准：
    // 每次跑 work\build_app.bat NiDaw 都会重新生成它，所以改完代码先构建一次，
    // 编辑器里的"无法打开源文件"就会消失。
    "version": 4,
    "configurations": [
        {
            "name": "HM · MSVC x64",
            "compileCommands": "${workspaceFolder}/../work/app-build5/compile_commands.json",
            "includePath": [
                "${workspaceFolder}/Source",
                "${workspaceFolder}/external/JUCE/modules"
            ],
            "defines": [
                "JUCE_WEB_BROWSER=0",
                "JUCE_USE_CURL=0",
                "JUCE_STANDALONE_APPLICATION=1"
            ],
            "cStandard": "c17",
            "cppStandard": "c++20",
            "intelliSenseMode": "windows-msvc-x64",
            "compilerPath": "C:/Program Files/Microsoft Visual Studio/18/Enterprise/VC/Tools/MSVC/14.52.36725/bin/Hostx64/x64/cl.exe"
        }
    ]
}
